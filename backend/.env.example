# Server
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mams_db?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/mams_db?schema=public"
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mams_test_db?schema=public"

# JWT Secrets (replace with strong random secrets in production)
JWT_SECRET=replace-with-strong-access-token-secret
JWT_REFRESH_SECRET=replace-with-strong-refresh-token-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Logistics Officer Policy (true = global logistics access, false = restricted to assigned home base)
LOGISTICS_GLOBAL_SCOPE=true

# Development Seed Credentials (DO NOT use in production; never commit real secrets)
SEED_ENABLE_DEV_ACCOUNTS=true
SEED_ADMIN_USERNAME=admin_user
SEED_ADMIN_PASSWORD=AdminPass123!
SEED_COMMANDER_USERNAME=commander_alpha
SEED_COMMANDER_PASSWORD=CommandPass123!
SEED_LOGISTICS_USERNAME=logistics_officer
SEED_LOGISTICS_PASSWORD=LogisticsPass123!
