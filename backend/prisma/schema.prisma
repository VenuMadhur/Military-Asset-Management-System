generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  BASE_COMMANDER
  LOGISTICS_OFFICER
}

enum EquipmentCategory {
  VEHICLE
  WEAPON
  AMMUNITION
  OTHER
}

enum TransferStatus {
  PENDING
  APPROVED
  IN_TRANSIT
  COMPLETED
  REJECTED
  CANCELLED
}

enum AssignmentStatus {
  ACTIVE
  RETURNED
}

enum TransactionType {
  PURCHASE
  TRANSFER_IN
  TRANSFER_OUT
  ASSIGNMENT
  ASSIGNMENT_RETURN
  EXPENDITURE
  ADJUSTMENT
}

model Base {
  id          String   @id @default(uuid())
  name        String   @unique
  location    String
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users                 User[]
  purchases             Purchase[]
  outgoingTransfers     Transfer[]             @relation("SourceBase")
  incomingTransfers     Transfer[]             @relation("DestinationBase")
  assignments           Assignment[]
  expenditures          Expenditure[]
  inventoryTransactions InventoryTransaction[]
  auditLogs             AuditLog[]

  @@index([isActive])
  @@map("bases")
}

model User {
  id               String   @id @default(uuid())
  username         String   @unique
  passwordHash     String   @map("password_hash")
  fullName         String?  @map("full_name")
  role             Role
  baseId           String?  @map("base_id")
  isActive         Boolean  @default(true) @map("is_active")
  refreshTokenHash String?  @map("refresh_token_hash")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  base                  Base?                  @relation(fields: [baseId], references: [id], onDelete: Restrict)
  purchases             Purchase[]             @relation("PurchaseCreatedBy")
  initiatedTransfers    Transfer[]             @relation("TransferInitiatedBy")
  approvedTransfers     Transfer[]             @relation("TransferApprovedBy")
  assignments           Assignment[]           @relation("AssignmentCreatedBy")
  expenditures          Expenditure[]          @relation("ExpenditureCreatedBy")
  inventoryTransactions InventoryTransaction[] @relation("TransactionCreatedBy")
  auditLogs             AuditLog[]

  @@index([role])
  @@index([baseId])
  @@index([isActive])
  @@map("users")
}

model EquipmentType {
  id          String            @id @default(uuid())
  name        String            @unique
  category    EquipmentCategory
  description String?
  unit        String            @default("UNITS")
  isActive    Boolean           @default(true) @map("is_active")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  purchases             Purchase[]
  transfers             Transfer[]
  assignments           Assignment[]
  expenditures          Expenditure[]
  inventoryTransactions InventoryTransaction[]

  @@index([category])
  @@index([isActive])
  @@map("equipment_types")
}

model Purchase {
  id              String   @id @default(uuid())
  baseId          String   @map("base_id")
  equipmentTypeId String   @map("equipment_type_id")
  quantity        Int
  purchaseDate    DateTime @map("purchase_date")
  referenceNumber String   @unique @map("reference_number")
  supplier        String
  remarks         String?
  createdBy       String   @map("created_by")
  createdAt       DateTime @default(now()) @map("created_at")

  base          Base          @relation(fields: [baseId], references: [id], onDelete: Restrict)
  equipmentType EquipmentType @relation(fields: [equipmentTypeId], references: [id], onDelete: Restrict)
  creator       User          @relation("PurchaseCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([baseId, equipmentTypeId])
  @@index([purchaseDate])
  @@index([createdBy])
  @@map("purchases")
}

model Transfer {
  id                String         @id @default(uuid())
  sourceBaseId      String         @map("source_base_id")
  destinationBaseId String         @map("destination_base_id")
  equipmentTypeId   String         @map("equipment_type_id")
  quantity          Int
  status            TransferStatus @default(PENDING)
  referenceNumber   String         @unique @map("reference_number")
  remarks           String?
  initiatedBy       String         @map("initiated_by")
  approvedBy        String?        @map("approved_by")
  completedAt       DateTime?      @map("completed_at")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  sourceBase      Base          @relation("SourceBase", fields: [sourceBaseId], references: [id], onDelete: Restrict)
  destinationBase Base          @relation("DestinationBase", fields: [destinationBaseId], references: [id], onDelete: Restrict)
  equipmentType   EquipmentType @relation(fields: [equipmentTypeId], references: [id], onDelete: Restrict)
  initiator       User          @relation("TransferInitiatedBy", fields: [initiatedBy], references: [id], onDelete: Restrict)
  approver        User?         @relation("TransferApprovedBy", fields: [approvedBy], references: [id], onDelete: Restrict)

  @@index([sourceBaseId, status])
  @@index([destinationBaseId, status])
  @@index([equipmentTypeId])
  @@index([status])
  @@index([completedAt])
  @@map("transfers")
}

model Assignment {
  id              String           @id @default(uuid())
  baseId          String           @map("base_id")
  equipmentTypeId String           @map("equipment_type_id")
  quantity        Int
  assignedTo      String           @map("assigned_to")
  assignmentDate  DateTime         @map("assignment_date")
  status          AssignmentStatus @default(ACTIVE)
  returnedAt      DateTime?        @map("returned_at")
  remarks         String?
  createdBy       String           @map("created_by")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  base          Base          @relation(fields: [baseId], references: [id], onDelete: Restrict)
  equipmentType EquipmentType @relation(fields: [equipmentTypeId], references: [id], onDelete: Restrict)
  creator       User          @relation("AssignmentCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([baseId, equipmentTypeId])
  @@index([assignmentDate])
  @@index([status])
  @@map("assignments")
}

model Expenditure {
  id              String   @id @default(uuid())
  baseId          String   @map("base_id")
  equipmentTypeId String   @map("equipment_type_id")
  quantity        Int
  expenditureDate DateTime @map("expenditure_date")
  reason          String
  referenceNumber String   @unique @map("reference_number")
  remarks         String?
  createdBy       String   @map("created_by")
  createdAt       DateTime @default(now()) @map("created_at")

  base          Base          @relation(fields: [baseId], references: [id], onDelete: Restrict)
  equipmentType EquipmentType @relation(fields: [equipmentTypeId], references: [id], onDelete: Restrict)
  creator       User          @relation("ExpenditureCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([baseId, equipmentTypeId])
  @@index([expenditureDate])
  @@map("expenditures")
}

model InventoryTransaction {
  id              String          @id @default(uuid())
  baseId          String          @map("base_id")
  equipmentTypeId String          @map("equipment_type_id")
  transactionType TransactionType @map("transaction_type")
  quantity        Int
  referenceType   String          @map("reference_type")
  referenceId     String          @map("reference_id")
  occurredAt      DateTime        @default(now()) @map("occurred_at")
  createdBy       String          @map("created_by")
  createdAt       DateTime        @default(now()) @map("created_at")

  base          Base          @relation(fields: [baseId], references: [id], onDelete: Restrict)
  equipmentType EquipmentType @relation(fields: [equipmentTypeId], references: [id], onDelete: Restrict)
  creator       User          @relation("TransactionCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([baseId, equipmentTypeId, occurredAt])
  @@index([transactionType, occurredAt])
  @@index([referenceType, referenceId])
  @@map("inventory_transactions")
}

model AuditLog {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  action         String
  entityType     String   @map("entity_type")
  entityId       String   @map("entity_id")
  baseId         String?  @map("base_id")
  previousValues Json?    @map("previous_values")
  newValues      Json?    @map("new_values")
  details        String?
  ipAddress      String?  @map("ip_address")
  createdAt      DateTime @default(now()) @map("created_at")

  user User  @relation(fields: [userId], references: [id], onDelete: Restrict)
  base Base? @relation(fields: [baseId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([entityType, entityId])
  @@index([baseId, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}
